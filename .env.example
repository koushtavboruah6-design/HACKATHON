# Required for live Gemini prescription extraction, translation, and TTS
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (must be 3000 in AI Studio preview)
PORT=3000

# Set to "true" to default to cached Demo Mode responses on startup
DEMO_MODE=false

# Optional: Twilio credentials for live caregiver WhatsApp/SMS alerts
# If omitted, alerts are logged to the in-app Caregiver Alert Feed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
